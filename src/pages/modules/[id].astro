---
import Base from '../../layouts/Base.astro';
import { SUBJECTS, MODULE_MAP, PHYSNET_PDF_BASE } from '../../data/modules.js';
import prereqData from '../../data/prerequisites.json';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

export function getStaticPaths() {
  return SUBJECTS.flatMap(s =>
    s.modules.map(m => ({ params: { id: m.id } }))
  );
}

const { id } = Astro.params;
const mod = MODULE_MAP[id];
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Load pre-generated HTML content if available
const contentPath = join(process.cwd(), 'src/content/modules', `${id}.html`);
const rawHtml = existsSync(contentPath) ? readFileSync(contentPath, 'utf-8') : null;

// Split at </header> so we can render the module-header block first, then pathway bar, then body
let moduleHeaderHtml = null;
let moduleBodyHtml = null;
if (rawHtml) {
  const splitTag = '</header>';
  const idx = rawHtml.indexOf(splitTag);
  if (idx !== -1) {
    moduleHeaderHtml = rawHtml.slice(0, idx + splitTag.length);
    moduleBodyHtml = rawHtml.slice(idx + splitTag.length);
  } else {
    moduleBodyHtml = rawHtml;
  }
}

// Prerequisite graph data
const prereqs  = (prereqData.prereqs[id] || []).map(pid => ({
  id: pid, title: MODULE_MAP[pid]?.title || prereqData.titles[pid] || pid.toUpperCase(), hasHtml: MODULE_MAP[pid]?.hasHtml || false
}));
const unlocks  = (prereqData.unlocks[id] || []).map(pid => ({
  id: pid, title: MODULE_MAP[pid]?.title || prereqData.titles[pid] || pid.toUpperCase(), hasHtml: MODULE_MAP[pid]?.hasHtml || false
}));

// Build local graph data for visualization (current node + neighbors)
const graphNodes = [
  { id, title: mod.title, type: 'current' },
  ...prereqs.map(p  => ({ id: p.id, title: p.title, type: 'prereq'  })),
  ...unlocks.map(u  => ({ id: u.id, title: u.title, type: 'unlocks' })),
];
const graphLinks = [
  ...prereqs.map(p  => ({ source: p.id, target: id })),
  ...unlocks.map(u  => ({ source: id,   target: u.id })),
];
---
<Base title={mod.title} description={`PHYSNET module ${id}: ${mod.title}`}>
  <div class="top-bar">
    <nav class="breadcrumb">
      <a href={b}>Catalog</a>
      <span>›</span>
      <a href={`${b}#${mod.subjectId}`}>{mod.subject}</a>
      <span>›</span>
      <span>{id.toUpperCase()}</span>
    </nav>
    <div class="top-actions">
      <a href={`${PHYSNET_PDF_BASE}/${id}.pdf`} class="action-btn" target="_blank" rel="noopener">↓ PDF</a>
      {mod.hasInteractive && (
        <a href={`${b}interactive/force-diagrams/`} class="action-btn action-btn-purple">▶ Interactive</a>
      )}
    </div>
  </div>

  {moduleHeaderHtml ? (
    <div class="module-header-block" set:html={moduleHeaderHtml} />
  ) : (
    <div class="module-header-fallback">
      <h1>{mod.title}</h1>
      <p class="module-meta">Module {id.toUpperCase()} &bull; {mod.subject}</p>
    </div>
  )}

  {(prereqs.length > 0 || unlocks.length > 0) && (
    <div class="pathway-bar">
      {prereqs.length > 0 && (
        <div class="pathway-panel">
          <div class="pathway-label">Prerequisites</div>
          <div class="pathway-chips">
            {prereqs.map(p => (
              <a href={`${b}modules/${p.id}/`} class={`chip chip-prereq ${p.hasHtml ? 'chip-html' : ''}`}>
                {p.id.toUpperCase()} <span class="chip-title">{p.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
      {unlocks.length > 0 && (
        <div class="pathway-panel">
          <div class="pathway-label">Unlocks</div>
          <div class="pathway-chips">
            {unlocks.map(u => (
              <a href={`${b}modules/${u.id}/`} class={`chip chip-unlocks ${u.hasHtml ? 'chip-html' : ''}`}>
                {u.id.toUpperCase()} <span class="chip-title">{u.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
      <button id="toggleGraph" class="graph-toggle">Show dependency graph</button>
      <div id="graphContainer" style="display:none">
        <svg id="depGraph"></svg>
      </div>
    </div>
  )}

  {moduleBodyHtml ? (
    <div class="module-content" set:html={moduleBodyHtml} />
  ) : (
    <div class="no-html-notice">
      <div class="notice-icon">📄</div>
      <h2>PDF Only</h2>
      <p>
        This module is currently available as a PDF only. HTML versions are being
        generated from the original LaTeX source files.
      </p>
      <a
        href={`${PHYSNET_PDF_BASE}/${id}.pdf`}
        class="action-btn"
        target="_blank"
        rel="noopener"
      >
        Open PDF on physnet.org ↗
      </a>
    </div>
  )}
</Base>

<script define:vars={{ graphNodes, graphLinks, b }}>
document.getElementById('toggleGraph')?.addEventListener('click', function() {
  const container = document.getElementById('graphContainer');
  const visible = container.style.display !== 'none';
  container.style.display = visible ? 'none' : 'block';
  this.textContent = visible ? 'Show dependency graph' : 'Hide dependency graph';
  if (!visible) drawGraph();
});

function drawGraph() {
  const svg = document.getElementById('depGraph');
  if (svg.dataset.drawn) return;
  svg.dataset.drawn = '1';

  const W = svg.parentElement.clientWidth || 700, H = 320;
  svg.setAttribute('width', W); svg.setAttribute('height', H);
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

  const colors = { current: '#1e3a5f', prereq: '#dc2626', unlocks: '#16a34a' };

  // Simple force-directed layout using requestAnimationFrame
  const nodes = graphNodes.map((n, i) => ({
    ...n, x: W/2 + (Math.random()-0.5)*200, y: H/2 + (Math.random()-0.5)*150
  }));
  const nodeById = Object.fromEntries(nodes.map(n => [n.id, n]));
  const links = graphLinks.map(l => ({
    source: nodeById[l.source], target: nodeById[l.target]
  })).filter(l => l.source && l.target);

  // Pin prereqs left, current center, unlocks right
  nodes.forEach(n => {
    if (n.type === 'prereq')   n.x = W * 0.2;
    if (n.type === 'current')  n.x = W * 0.5;
    if (n.type === 'unlocks')  n.x = W * 0.8;
  });

  const ns = svg.namespaceURI;
  function el(tag, attrs) {
    const e = document.createElementNS(ns, tag);
    for (const [k,v] of Object.entries(attrs)) e.setAttribute(k, v);
    return e;
  }

  // Arrow marker
  const defs = el('defs', {});
  const marker = el('marker', { id:'arrow', markerWidth:'8', markerHeight:'8',
    refX:'16', refY:'3', orient:'auto' });
  marker.appendChild(el('path', { d:'M0,0 L0,6 L8,3 z', fill:'#94a3b8' }));
  defs.appendChild(marker); svg.appendChild(defs);

  // Draw links
  const linkEls = links.map(l => {
    const line = el('line', { stroke:'#94a3b8', 'stroke-width':'1.5',
      'marker-end':'url(#arrow)' });
    svg.appendChild(line);
    return { el: line, link: l };
  });

  // Draw nodes
  const nodeEls = nodes.map(n => {
    const g = el('g', { style:'cursor:pointer' });
    const circle = el('circle', { r:'18', fill: colors[n.type] || '#64748b',
      stroke:'white', 'stroke-width':'2' });
    const label = el('text', { 'text-anchor':'middle', dy:'0.35em',
      fill:'white', 'font-size':'10', 'font-weight':'bold',
      'font-family':'system-ui,sans-serif' });
    label.textContent = n.id.toUpperCase();
    // Place title beside circle (inward toward center), below for current node
    const titleAnchor = n.type === 'prereq' ? 'start' : n.type === 'unlocks' ? 'end' : 'middle';
    const titleDx = n.type === 'prereq' ? '22' : n.type === 'unlocks' ? '-22' : '0';
    const titleDy = (n.type === 'prereq' || n.type === 'unlocks') ? '0.35em' : '2.8em';
    const title = el('text', { 'text-anchor': titleAnchor, dx: titleDx, dy: titleDy,
      fill:'#334155', 'font-size':'9', 'font-family':'system-ui,sans-serif' });
    title.textContent = n.title.length > 28 ? n.title.slice(0,26)+'…' : n.title;
    g.appendChild(circle); g.appendChild(label); g.appendChild(title);
    g.addEventListener('click', () => { window.location.href = `${b}modules/${n.id}/`; });
    svg.appendChild(g);
    return { el: g, node: n };
  });

  // Spread nodes of same type vertically
  ['prereq','unlocks'].forEach(type => {
    const same = nodes.filter(n => n.type === type);
    same.forEach((n, i) => { n.y = H * (i+1) / (same.length+1); });
  });
  nodes.filter(n => n.type === 'current').forEach(n => { n.y = H/2; });

  function tick() {
    linkEls.forEach(({el, link}) => {
      el.setAttribute('x1', link.source.x); el.setAttribute('y1', link.source.y);
      el.setAttribute('x2', link.target.x); el.setAttribute('y2', link.target.y);
    });
    nodeEls.forEach(({el, node}) => {
      el.setAttribute('transform', `translate(${node.x},${node.y})`);
    });
  }
  tick();
}
</script>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: system-ui, sans-serif;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .breadcrumb a { color: var(--blue); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .top-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .module-header-fallback {
    margin-bottom: 1.5rem;
  }
  .module-meta {
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }
  .action-btn {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.8rem;
    background: none;
    color: var(--blue);
    border: 1px solid var(--blue);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .action-btn:hover { background: var(--blue); color: white; }
  .action-btn-purple { color: #7c3aed; border-color: #7c3aed; }
  .action-btn-purple:hover { background: #7c3aed; color: white; }
  /* Module header block (generated HTML <header>) */
  .module-header-block {
    margin-bottom: 0;
  }
  .no-html-notice {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    max-width: 32rem;
    margin: 0 auto;
  }
  .notice-icon { font-size: 3rem; margin-bottom: 1rem; }
  .no-html-notice h2 {
    font-size: 1.2rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
  }
  .no-html-notice p {
    color: var(--text-muted);
    font-size: 0.925rem;
    margin-bottom: 1.5rem;
  }
  /* ── Pathway bar ── */
  .pathway-bar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pathway-panel { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0.5rem; }
  .pathway-label {
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    padding-top: 0.3rem;
    min-width: 6rem;
  }
  .pathway-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    text-decoration: none;
    border: 1px solid;
    transition: opacity 0.15s;
  }
  .chip:hover { opacity: 0.8; }
  .chip-prereq  { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
  .chip-unlocks { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
  .chip-html    { font-weight: 600; }
  .chip-title   { font-weight: 400; color: inherit; opacity: 0.8; font-size: 0.72rem; }
  .graph-toggle {
    align-self: flex-start;
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    padding: 0.3rem 0.8rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--blue);
    cursor: pointer;
  }
  .graph-toggle:hover { background: var(--bg); }
  #graphContainer { width: 100%; margin-top: 0.5rem; }
  #depGraph { width: 100%; border-radius: var(--radius); background: #f8faff; }

  /* ── Module content styles ── */
  .module-content :global(.skills-block) {
    margin: 0.6rem 0 0.75rem 0;
  }
  .module-content :global(.skills-block h4) {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
  }
  .module-content :global(.skills-block h4::after) {
    content: ':';
  }
  .module-content :global(.skills-block ul),
  .module-content :global(.skills-block ol) {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .module-content :global(.skills-block li) {
    font-size: 0.9rem;
    line-height: 1.55;
    padding-left: 2.5rem;
    position: relative;
    margin-bottom: 0.2rem;
  }
  .module-content :global(.skills-block li .item-label),
  .module-content :global(.skills-block li strong:first-child) {
    position: absolute;
    left: 0;
    width: 2.2rem;
    font-weight: 600;
  }
  .content-placeholder {
    background: #fefce8;
    border: 1px solid #fde68a;
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    color: #92400e;
    font-family: system-ui, sans-serif;
    font-size: 0.875rem;
  }
</style>
