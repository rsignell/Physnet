---
import Base from '../../../layouts/Base.astro';

const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const problems = [
  { no: 0,  title: 'Hanging Ball (Simple)',           desc: 'A ball hanging vertically on a string. Draw just the gravity force (1 force).', available: true },
  { no: 1,  title: 'Ball on Angled String',           desc: 'A ball hanging on a string at an angle. Draw resultant, gravity, and string forces.', available: true },
  { no: 2,  title: 'Person on Horizontal Surface',    desc: 'A stationary person on a level floor. Draw resultant, gravity, and surface forces.', available: true },
  { no: 3,  title: 'Person Pushed Horizontally',      desc: 'A person accelerating on a level floor. Draw resultant, gravity, and surface forces.', available: true },
  { no: 4,  title: 'Person on Floor (4 Forces)',      desc: 'Accelerating person on level floor. Draw resultant, gravity, normal, and friction forces.', available: true },
  { no: 5,  title: 'Box on Inclined Plane',           desc: 'A stationary block on an inclined surface. Draw resultant, gravity, and surface force.', available: true },
  { no: 6,  title: 'Box on Incline (4 Forces)',       desc: 'Stationary block on incline. Draw resultant, gravity, normal, and friction in two coordinate systems.', available: true },
  { no: 7,  title: 'Person on Incline (Static)',      desc: 'A stationary person on an inclined surface. Draw 4 forces in two coordinate systems.', available: true },
  { no: 8,  title: 'Person on Incline (Dynamic)',     desc: 'A person accelerating up an inclined surface. Draw 4 forces in two coordinate systems.', available: true },
  { no: 9,  title: 'Pulley: Forces on Block',         desc: 'Person holds a block via a horizontal pulley. Draw forces on the block (resultant, gravity, string).', available: true },
  { no: 10, title: 'Pulley: Forces on Person',        desc: 'Person holds a block via a horizontal pulley. Draw 4 forces on the person including surface reaction.', available: true },
  { no: 11, title: 'Pulley: Person (No Resultant)',   desc: 'Pulley problem with person. Draw gravity, string, normal, and friction — no resultant.', available: true },
];
---
<Base title="One-Body Force Diagrams" activePage="interactive">
  <div class="page-header">
    <nav class="breadcrumb">
      <a href={`${b}interactive/`}>Interactive Tools</a>
      <span>›</span>
      <span>One-Body Force Diagrams</span>
    </nav>
    <h1>One-Body Force Diagrams</h1>
    <p>
      Draw the forces acting on an object using your mouse. Each force is checked
      for correct direction and magnitude. Based on the original Java applet by
      Peter Signell (Michigan State University, 1997).
    </p>
  </div>

  <div class="instruction-box">
    <h2>How it works</h2>
    <ol>
      <li>Read the physical scenario shown in the upper-left panel.</li>
      <li>Note the weight and unit vectors displayed.</li>
      <li>Click to begin, then <strong>drag</strong> from the center dot to draw each force vector.</li>
      <li>The exercise accepts your answer when direction and magnitude are close enough.</li>
      <li>Correct forces appear in the results panel as equations.</li>
    </ol>
  </div>

  <h2 class="problems-heading">
    Problems
    <span class="avail-badge">12 of 12 available</span>
  </h2>

  <div class="problem-grid">
    {problems.map(p => (
      <div class={`problem-card ${p.available ? 'available' : 'unavailable'}`}>
        <div class="problem-number">Problem {p.no + 1}</div>
        <h3>{p.title}</h3>
        <p>{p.desc}</p>
        {p.available
          ? <a href={`${b}interactive/force-diagrams/problem${p.no}.html`} class="btn btn-start">
              Start →
            </a>
          : <span class="btn-disabled">Coming Soon</span>
        }
      </div>
    ))}
  </div>
</Base>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: system-ui, sans-serif;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a { color: var(--blue); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .instruction-box {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }
  .instruction-box h2 {
    font-size: 1rem;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }
  .instruction-box ol {
    padding-left: 1.25rem;
    color: var(--text);
    font-size: 0.925rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .problems-heading {
    font-family: system-ui, sans-serif;
    font-size: 1.1rem;
    color: var(--navy);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .avail-badge {
    font-size: 0.75rem;
    font-weight: 500;
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }
  .problem-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .problem-card.available {
    border-color: #bfdbfe;
    background: #f0f7ff;
  }
  .problem-number {
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .problem-card.available .problem-number { color: var(--blue); }
  .problem-card h3 {
    font-size: 0.9rem;
    color: var(--navy);
    line-height: 1.35;
  }
  .problem-card p {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex: 1;
  }
  .btn-start {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    background: var(--blue);
    color: white;
    border-radius: var(--radius);
    text-decoration: none;
    text-align: center;
    margin-top: 0.25rem;
    transition: opacity 0.15s;
  }
  .btn-start:hover { opacity: 0.85; }
  .btn-disabled {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.45rem 1rem;
    background: var(--bg);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    margin-top: 0.25rem;
    cursor: not-allowed;
  }
</style>
